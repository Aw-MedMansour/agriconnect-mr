# ===== Build-time (public, embedded in the browser bundle) =====
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT

# ===== Runtime (server only — never prefix with VITE_) =====
# Required
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Optional: only for privileged server operations (not used by current features)
SUPABASE_SERVICE_ROLE_KEY=
# Required for Plant AI chat and plant photo analysis (Lovable AI Gateway)
LOVABLE_API_KEY=

# Server
PORT=3000
HOST=0.0.0.0
