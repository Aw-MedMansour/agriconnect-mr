# AgriConnect MR — self-hosted configuration. Copy to .env.production; never commit real values.
# Generate secrets with:  openssl rand -base64 48

# ===== PostgreSQL 18 (docker compose service "db") =====
POSTGRES_DB=agriconnect
POSTGRES_USER=agriconnect
POSTGRES_PASSWORD=change-me-strong-password
# Internal Docker network address; the database port is never published.
DATABASE_URL=postgres://agriconnect:change-me-strong-password@db:5432/agriconnect

# ===== Sessions & media (server only, min 32 characters each) =====
SESSION_SECRET=
MEDIA_SIGNING_SECRET=
MEDIA_DIR=/app/data/media

# ===== AI features (Plant AI chat, plant photo analysis) — optional =====
LOVABLE_API_KEY=

# ===== Backups =====
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# ===== Server =====
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Plant AI — native Google Gemini (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
